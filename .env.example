# LLM
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_MODEL=deepseek-v4-flash-0731
# Optional: set false only when the configured provider supports this disable convention.
# OPENAI_ENABLE_THINKING=false
OPENAI_TEMPERATURE=0.8

# Optional MinerU fallback. These values can also be set in the model management page.
MINERU_API_BASE_URL=https://mineru.net
MINERU_API_KEY=

# API document pipeline concurrency and long-PDF chunking.
NIANLUN_API_MINERU_SUBMIT_WORKERS=4
NIANLUN_API_MINERU_POLL_WORKERS=4
NIANLUN_API_ENRICH_WORKERS=4
NIANLUN_API_LLM_MAX_CONCURRENT=8
NIANLUN_API_LLM_PER_DOCUMENT_CONCURRENT=4
NIANLUN_API_LLM_REQUEST_TIMEOUT_SECONDS=600
NIANLUN_API_PDF_CHUNK_MAX_PAGES=180
NIANLUN_API_PDF_CHUNK_OVERLAP_PAGES=0
NIANLUN_API_PDF_MAX_CHUNKS=100
NIANLUN_API_DOCUMENT_STAGING_MAX_BYTES=2147483648
NIANLUN_API_MINERU_ZIP_MAX_ENTRIES=10000
NIANLUN_API_MINERU_ZIP_MAX_COMPRESSION_RATIO=200
NIANLUN_API_PIPELINE_LEASE_SECONDS=300
NIANLUN_API_SNAPSHOT_MIN_RETENTION_SECONDS=86400
NIANLUN_API_STAGING_ORPHAN_RETENTION_SECONDS=86400

# Knowledge base
NIANLUN_WORKSPACE=data/workspaces/default

# Current Milvus FTS collection for the migrated default knowledge base.
# The API Server stores the exact per-knowledge-base collection in SQLite.
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_NODE_FTS_COLLECTION=pageindex_node_fts_18b7abeab1127eeb
# Mixed Chinese/English FTS analyzer. Use whatlang only for servers that need it.
MILVUS_LANGUAGE_IDENTIFIER=lingua

# Optional semantic document routing
MILVUS_DOC_VECTOR_COLLECTION=pageindex_doc_vectors
# When sharing the vector collection across workspaces, pass the matching
# --knowledge-base-id while building; runtime receives it from KnowledgeBaseConfig.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1024
NIANLUN_VECTOR_ENABLED=false

# Optional vector routing in API Server (the collection must be built offline first).
NIANLUN_API_VECTOR_ENABLED=false
NIANLUN_API_VECTOR_COLLECTION=pageindex_doc_vectors
# Optional API-specific overrides; empty values inherit EMBEDDING_MODEL/EMBEDDING_DIM.
NIANLUN_API_EMBEDDING_MODEL=
NIANLUN_API_EMBEDDING_DIM=
