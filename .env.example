# LLM
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_MODEL=deepseek-v4-flash-0731
# Optional: set false only when the configured provider supports this disable convention.
# OPENAI_ENABLE_THINKING=false
OPENAI_TEMPERATURE=0.8

# Optional MinerU fallback. These values can also be set in the model management page.
MINERU_API_BASE_URL=https://mineru.net
MINERU_API_KEY=

# API document pipeline concurrency and long-PDF chunking.
NIANLUN_API_MINERU_SUBMIT_WORKERS=4
NIANLUN_API_MINERU_POLL_WORKERS=4
NIANLUN_API_ENRICH_WORKERS=4
NIANLUN_API_LLM_MAX_CONCURRENT=8
NIANLUN_API_LLM_PER_DOCUMENT_CONCURRENT=4
NIANLUN_API_LLM_REQUEST_TIMEOUT_SECONDS=600
NIANLUN_API_PDF_CHUNK_MAX_PAGES=180
NIANLUN_API_PDF_CHUNK_OVERLAP_PAGES=0
NIANLUN_API_PDF_MAX_CHUNKS=100
NIANLUN_API_DOCUMENT_STAGING_MAX_BYTES=2147483648
NIANLUN_API_MINERU_ZIP_MAX_ENTRIES=10000
NIANLUN_API_MINERU_ZIP_MAX_COMPRESSION_RATIO=200
NIANLUN_API_PIPELINE_LEASE_SECONDS=300
NIANLUN_API_SNAPSHOT_MIN_RETENTION_SECONDS=86400
NIANLUN_API_STAGING_ORPHAN_RETENTION_SECONDS=86400

# Published application API; expose only through the runtime gateway allowlist.
NIANLUN_API_APPLICATION_ENABLED=false
NIANLUN_API_APPLICATION_MAX_CONCURRENT=8
NIANLUN_API_APPLICATION_APP_CONCURRENT=4
NIANLUN_API_APPLICATION_CLIENT_CONCURRENT=2
NIANLUN_API_APPLICATION_REQUESTS_PER_MINUTE=60
NIANLUN_API_APPLICATION_TIMEOUT_SECONDS=300
NIANLUN_API_APPLICATION_RETENTION_DAYS=30

# WeCom channel platform side. The internal token is shared with the standalone
# gateway and must be at least 32 characters with no surrounding whitespace;
# leave it empty to disable /internal routes and WeCom channel management.
NIANLUN_INTERNAL_TOKEN=
# Comma-separated gateway control base URLs, e.g. http://127.0.0.1:3100.
NIANLUN_GATEWAY_CONTROL_URLS=
NIANLUN_GATEWAY_CONTROL_TOKEN=
NIANLUN_GATEWAY_CONTROL_TIMEOUT_SECONDS=2
NIANLUN_WECOM_MAX_CONCURRENT=32
NIANLUN_WECOM_RUN_TIMEOUT_SECONDS=120
NIANLUN_WECOM_CONVERSATION_RETENTION_DAYS=30

# Standalone WeCom long-connection gateway: python -m app.channel_gateway
# Keep the control listener on a private interface; never expose it publicly.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3100
GATEWAY_LOG_LEVEL=INFO
NIANLUN_API_URL=http://127.0.0.1:8000
# local: one gateway instance. redis: required for multiple instances sharing bots.
GATEWAY_OWNERSHIP_BACKEND=local
# REDIS_URL=redis://127.0.0.1:6379/0
GATEWAY_REDIS_KEY_PREFIX=nianlun:channel-gateway
GATEWAY_LEASE_TTL_MS=30000
GATEWAY_LEASE_SAFETY_MS=5000
GATEWAY_SNAPSHOT_INTERVAL_SECONDS=30
GATEWAY_STATUS_HEARTBEAT_SECONDS=30
GATEWAY_CONNECT_TIMEOUT_SECONDS=10
GATEWAY_FIRST_EVENT_TIMEOUT_SECONDS=30
GATEWAY_WORKFLOW_TIMEOUT_SECONDS=150
GATEWAY_MAX_CONCURRENT=32
GATEWAY_MAX_MESSAGE_BYTES=65536
GATEWAY_MAX_ANSWER_BYTES=1048576
GATEWAY_REPLY_MAX_BYTES=20480
GATEWAY_STREAM_INTERVAL_MS=300
GATEWAY_STREAM_KEEPALIVE_SECONDS=15
GATEWAY_DEDUP_MAX_ENTRIES=10000
GATEWAY_DEDUP_TTL_SECONDS=300

# Knowledge base
NIANLUN_WORKSPACE=data/workspaces/default

# Current Milvus FTS collection for the migrated default knowledge base.
# The API Server stores the exact per-knowledge-base collection in SQLite.
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_NODE_FTS_COLLECTION=pageindex_node_fts_18b7abeab1127eeb
# Mixed Chinese/English FTS analyzer. Use whatlang only for servers that need it.
MILVUS_LANGUAGE_IDENTIFIER=lingua

# Optional semantic document routing
MILVUS_DOC_VECTOR_COLLECTION=pageindex_doc_vectors
# When sharing the vector collection across workspaces, pass the matching
# --knowledge-base-id while building; runtime receives it from KnowledgeBaseConfig.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1024
NIANLUN_VECTOR_ENABLED=false

# Optional vector routing in API Server (the collection must be built offline first).
NIANLUN_API_VECTOR_ENABLED=false
NIANLUN_API_VECTOR_COLLECTION=pageindex_doc_vectors
# Optional API-specific overrides; empty values inherit EMBEDDING_MODEL/EMBEDDING_DIM.
NIANLUN_API_EMBEDDING_MODEL=
NIANLUN_API_EMBEDDING_DIM=
