# LLM
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_MODEL=deepseek-v4-flash-0731
OPENAI_ENABLE_THINKING=true
OPENAI_TEMPERATURE=0.8

# Optional MinerU fallback. These values can also be set in the model management page.
MINERU_API_BASE_URL=https://mineru.net
MINERU_API_KEY=

# Knowledge base
NIANLUN_WORKSPACE=data/workspaces/default

# Current Milvus FTS collection for the migrated default knowledge base.
# The API Server stores the exact per-knowledge-base collection in SQLite.
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_NODE_FTS_COLLECTION=pageindex_node_fts_18b7abeab1127eeb

# Optional semantic document routing
MILVUS_DOC_VECTOR_COLLECTION=pageindex_doc_vectors
# When sharing the vector collection across workspaces, pass the matching
# --knowledge-base-id while building; runtime receives it from KnowledgeBaseConfig.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1024
NIANLUN_VECTOR_ENABLED=false

# Optional vector routing in API Server (the collection must be built offline first).
NIANLUN_API_VECTOR_ENABLED=false
NIANLUN_API_VECTOR_COLLECTION=pageindex_doc_vectors
# Optional API-specific overrides; empty values inherit EMBEDDING_MODEL/EMBEDDING_DIM.
NIANLUN_API_EMBEDDING_MODEL=
NIANLUN_API_EMBEDDING_DIM=
